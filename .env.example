# ---- Database (required for products/orders/admin) ----
# Get a free cluster at https://www.mongodb.com/atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/perfectfit?retryWrites=true&w=majority

# ---- Admin auth ----
# A long random string. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
# First admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@perfectfit.com
ADMIN_PASSWORD=changeme123

# ---- Razorpay (optional; COD works without these) ----
# Test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Cloudinary (optional; admin can paste image URLs without this) ----
# Create an unsigned upload preset at https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number for order support (digits only, incl country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
